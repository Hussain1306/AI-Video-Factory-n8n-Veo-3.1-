    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst ex = e.execution || {};\nconst wf = e.workflow || {};\nconst msg = [\n  'Workflow: ' + (wf.name || '?'),\n  'Failed node: ' + (ex.lastNodeExecuted || '?'),\n  'Error: ' + ((ex.error && ex.error.message) || 'unknown'),\n  'Execution: ' + (ex.url || ex.id || '?'),\n  '', String((ex.error && ex.error.stack) || '').split('\\n').slice(0, 6).join('\\n')\n].join('\\n');\nreturn [{ json: { subject: 'n8n alert: ' + (wf.name || 'workflow') + ' failed', message: msg } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "53584516-10e3-48a2-9aff-531cb024046c",
